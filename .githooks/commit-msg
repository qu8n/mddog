#!/bin/sh
grep -viE '^(Co-authored-by: .*(claude|anthropic|codex|openai|copilot|cursor)|.*Generated with \[?Claude Code)' "$1" > "$1.tmp"
mv "$1.tmp" "$1"
subject=$(grep -v '^#' "$1" | head -n 1)
case $subject in
  "Merge "* | "Revert \""* | "fixup! "* | "squash! "* | "amend! "*) exit 0 ;;
esac
exec "$(dirname "$0")/subject-check" "$subject"
