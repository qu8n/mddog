#!/usr/bin/env bash
subject=$1

if [[ $subject =~ ^chore:\ release\ [0-9]+\.[0-9]+\.[0-9]+$ ]]; then
  exit 0
fi

pattern='^(feat|fix|refactor|perf|docs|test|build|ci|chore|style)(\([a-z0-9-]+\))?!?: .+'

if ! [[ $subject =~ $pattern ]]; then
  echo "subject-check: \"$subject\" must match $pattern" >&2
  exit 1
fi

if (( ${#subject} > 72 )); then
  echo "subject-check: \"$subject\" is ${#subject} characters, the limit is 72" >&2
  exit 1
fi
