<span class="pl-c"><span class="pl-c">//</span> Debounce a function so it runs once input settles.</span>
<span class="pl-k">export</span> <span class="pl-k">function</span> <span class="pl-en">debounce</span>(<span class="pl-smi">fn</span>, <span class="pl-smi">wait</span> <span class="pl-k">=</span> <span class="pl-c1">100</span>) {
  <span class="pl-k">let</span> timer;
  <span class="pl-k">return</span> (<span class="pl-k">...</span><span class="pl-v">args</span>) <span class="pl-k">=&gt;</span> {
    <span class="pl-c1">clearTimeout</span>(timer);
    timer <span class="pl-k">=</span> <span class="pl-c1">setTimeout</span>(() <span class="pl-k">=&gt;</span> <span class="pl-smi">fn</span>.<span class="pl-c1">apply</span>(<span class="pl-c1">this</span>, args), wait);
  };
}
