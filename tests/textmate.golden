<span class="pl-c"><span class="pl-c">///</span> Count how often each word appears.</span>
<span class="pl-k">fn</span> <span class="pl-en">word_counts</span>(<span class="pl-smi">text</span><span class="pl-k">:</span> <span class="pl-k">&amp;</span><span class="pl-k">str</span>) <span class="pl-k">-&gt;</span> <span class="pl-en">HashMap</span>&lt;<span class="pl-k">&amp;</span><span class="pl-k">str</span>, <span class="pl-k">usize</span>&gt; {
    <span class="pl-k"><span class="pl-k">let</span></span> <span class="pl-k">mut</span> <span class="pl-smi">counts</span> <span class="pl-k">=</span> <span class="pl-en">HashMap</span><span class="pl-k">::</span><span class="pl-en">new</span>();
    <span class="pl-k">for</span> <span class="pl-smi">word</span> <span class="pl-k">in</span> <span class="pl-smi">text</span><span class="pl-k">.</span><span class="pl-en">split_whitespace</span>() {
        <span class="pl-k">*</span><span class="pl-smi">counts</span><span class="pl-k">.</span><span class="pl-en">entry</span>(<span class="pl-smi">word</span>)<span class="pl-k">.</span><span class="pl-en">or_insert</span>(<span class="pl-c1">0</span>) <span class="pl-k">+=</span> <span class="pl-c1">1</span>;
    }
    <span class="pl-smi">counts</span>
}
